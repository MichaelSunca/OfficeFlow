### 用户登录接口测试
POST http://localhost:8080/api/auth/login
Content-Type: application/json

{
  "username": "admin",
  "password": "123456"
}

> {%
    // 这是一个小脚本：登录成功后自动把返回的 token 存入全局变量
    client.global.set("auth_token", response.body.token);
    client.log("Token 已获取并存入变量: " + client.global.get("auth_token"));
%}